# URL pública de produção; substitua pelo endereço real mostrado na Vercel.
# Na Vercel, se estiver vazia, usa VERCEL_PROJECT_PRODUCTION_URL.
# Para desenvolvimento local, pode ficar vazia (indexação desativada).
NEXT_PUBLIC_SITE_URL=

# Opcional: habilite Web Analytics no painel da Vercel e depois altere para true.
# Faça um novo deploy após mudar esta variável. Não há eventos personalizados.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# O chat atual funciona sem chave de API e sem provedor de IA.
